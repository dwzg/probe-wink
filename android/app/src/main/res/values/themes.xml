<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ProbeWink" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Btn" parent="android:Widget.DeviceDefault.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:background">@drawable/btn_primary</item>
    </style>
    <style name="BtnQuiet" parent="android:Widget.DeviceDefault.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
    </style>
</resources>
