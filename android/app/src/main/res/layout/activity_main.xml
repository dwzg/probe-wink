<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- first run -->
            <LinearLayout
                android:id="@+id/setup_card"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="20dp"
                android:visibility="gone">
                <TextView style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Set up your modules" />
                <TextView style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textColor="@color/muted"
                    android:text="Choose the LH module (it takes all commands), then couple it with the RH module so both lamps can move. Switch the headlamps once to wake the modules first." />
                <Button
                    android:id="@+id/setup_start"
                    style="@style/Btn.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Get started" />
            </LinearLayout>

            <!-- status -->
            <LinearLayout
                android:id="@+id/status_card"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/conn_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot" />
                    <TextView
                        android:id="@+id/conn_text"
                        style="@style/T.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/conn_button"
                        style="@style/Btn.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="-10dp"
                        android:text="Connect" />
                </LinearLayout>
                <TextView
                    android:id="@+id/state"
                    style="@style/T.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
                <TextView
                    android:id="@+id/state_text"
                    style="@style/T.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/muted" />
                <TextView
                    android:id="@+id/reply"
                    style="@style/T.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_banner_danger"
                    android:padding="12dp"
                    android:textColor="@color/on_danger_soft"
                    android:visibility="gone" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/outline" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LH module" />
                        <TextView android:id="@+id/lh_status" style="@style/T.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RH module" />
                        <TextView android:id="@+id/rh_status" style="@style/T.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/act_lh"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wink_lh"
                    android:tint="@color/on_accent_soft" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView
                    android:id="@+id/act_lh_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wink LH"
                    android:textColor="@color/on_accent_soft"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/act_lh_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Left lamp"
                    android:textColor="@color/on_accent_soft"
                    android:alpha="0.75"
                    android:textSize="13sp" />
            </LinearLayout>
            <Space android:layout_width="12dp" android:layout_height="0dp" />
            <LinearLayout
                android:id="@+id/act_rh"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wink_rh"
                    android:tint="@color/on_accent_soft" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView
                    android:id="@+id/act_rh_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wink RH"
                    android:textColor="@color/on_accent_soft"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/act_rh_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Right lamp"
                    android:textColor="@color/on_accent_soft"
                    android:alpha="0.75"
                    android:textSize="13sp" />
            </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/act_both"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wink_both"
                    android:tint="@color/on_accent_soft" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView
                    android:id="@+id/act_both_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wink both"
                    android:textColor="@color/on_accent_soft"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/act_both_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flip and return"
                    android:textColor="@color/on_accent_soft"
                    android:alpha="0.75"
                    android:textSize="13sp" />
            </LinearLayout>
            <Space android:layout_width="12dp" android:layout_height="0dp" />
            <LinearLayout
                android:id="@+id/act_alt"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_swap"
                    android:tint="@color/on_accent_soft" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView
                    android:id="@+id/act_alt_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alternate"
                    android:textColor="@color/on_accent_soft"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/act_alt_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 s"
                    android:textColor="@color/on_accent_soft"
                    android:alpha="0.75"
                    android:textSize="13sp" />
            </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/act_stop"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_stop"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_stop"
                    android:tint="@color/on_danger_soft" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Stop"
                    android:textColor="@color/on_danger_soft"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/footer"
                style="@style/T.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
